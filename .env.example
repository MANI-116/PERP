# PerpX Environment Variables
# Copy to .env and fill in values for production

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/perps

# ── Auth ──────────────────────────────────────────────
JWT_PASS=change-this-to-a-random-secret-in-production

# ── API ───────────────────────────────────────────────
PORT=3001

# ── Oracle ────────────────────────────────────────────
BINANCE_URL=wss://fstream.binance.com/ws/!markPrice@arr@1s

# ── Frontend (set in Vercel dashboard) ────────────────
# NEXT_PUBLIC_API_BASE=https://your-backend.fly.dev
# NEXT_PUBLIC_WS_URL=wss://your-backend.fly.dev

# ── Redis (set in Fly.io secrets, not in .env) ────────
# REDIS_URL=redis://default:password@host:6379
