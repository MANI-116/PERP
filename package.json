{
  "name": "perps-v1-boilerplate",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10"
  },
  "scripts": {
    "backend": "bun --hot apps/backend/index.ts",
    "engine": "bun run apps/engine/index.ts",
    "db-poller": "bun run apps/dbPoller/index.ts",
    "wss":"bun run apps/wsServer/index.ts",
    "recover": "bun run scripts/recover-engine.ts",
    "test": "bun test apps/tests/",
    "test:engine": "bun test apps/tests/structuresTests/engine.test.ts",
    "test:integration": "bun test apps/tests/integration.test.ts"
  },
  "workspaces": [
    "apps/*",
    "apps/frontend/*",
    "packages/*"
  ],
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "redis": "^6.1.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  }
}
